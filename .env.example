# CareerPathDesk refuses to infer these boundaries. Copy this file to the ignored
# .env.local and replace generated local secrets there; do not commit that file.
CAREERPATH_RUNTIME_MODE=synthetic
CAREERPATH_HTTP_ADDR=127.0.0.1:8180
CAREERPATH_DATABASE_URL=postgres://careerpathdesk@127.0.0.1:55432/careerpathdesk_synthetic?sslmode=disable
CAREERPATH_DATABASE_PASSWORD_FILE=/absolute/path/to/careerpathdesk/.runtime/postgres_password
CAREERPATH_EXPECTED_SCHEMA_VERSION=9
CAREERPATH_SEED_PROFILE=synthetic-foundation-v1
CAREERPATH_SYNTHETIC_ACCOUNT_PASSWORD_FILE=/absolute/path/to/careerpathdesk/.runtime/synthetic_account_password
CAREERPATH_PUBLIC_ORIGIN=http://127.0.0.1:5173
CAREERPATH_ACCESS_TOKEN_PRIVATE_KEY_FILE=/absolute/path/to/careerpathdesk/.runtime/access_token_private_key.pem
